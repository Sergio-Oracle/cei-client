{
  "name": "cei-examen",
  "productName": "CEI Examen",
  "version": "1.0.0",
  "description": "Client d'examen sécurisé du Centre d'Examen Intelligent (UN-CHK) : mode kiosque, équivalent de Safe Exam Browser",
  "main": "src/main.js",
  "author": "UN-CHK — Centre d'Examen Intelligent",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/unit.js && node test/smoke.js",
    "test:unit": "node test/unit.js",
    "secret": "node scripts/make-secret.js",
    "build:linux": "node scripts/build.js linux",
    "build:win": "node scripts/build.js win",
    "build:mac": "node scripts/build.js mac",
    "build:all": "node scripts/build.js all",
    "release:patch": "node scripts/build.js all --bump patch",
    "release:minor": "node scripts/build.js all --bump minor",
    "release:major": "node scripts/build.js all --bump major"
  },
  "build": {
    "appId": "sn.unchk.cei.examen",
    "productName": "CEI Examen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "linux": {
      "category": "Education",
      "maintainer": "UN-CHK CEI <cei@unchk.sn>"
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://cei.unchk.sn"
}