{
  "name": "cei-examen",
  "productName": "CEI Examen",
  "version": "1.1.2",
  "description": "Client d'examen sécurisé du Centre d'Examen Intelligent (UN-CHK) : mode kiosque, équivalent de Safe Exam Browser",
  "main": "src/main.js",
  "author": "UN-CHK — Centre d'Examen Intelligent",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/unit.js && node test/smoke.js",
    "test:unit": "node test/unit.js",
    "secret": "node scripts/make-secret.js",
    "build:linux": "node scripts/build.js linux",
    "build:win": "node scripts/build.js win",
    "build:mac": "node scripts/build.js mac",
    "build:all": "node scripts/build.js all",
    "release:patch": "node scripts/build.js all --bump patch",
    "release:minor": "node scripts/build.js all --bump minor",
    "release:major": "node scripts/build.js all --bump major"
  },
  "build": {
    "appId": "sn.unchk.cei.examen",
    "productName": "CEI Examen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "linux": {
      "category": "Education",
      "maintainer": "UN-CHK CEI <cei@unchk.sn>",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "mimeTypes": [
        "x-scheme-handler/ceiexamen"
      ],
      "synopsis": "Client d'examen sécurisé",
      "description": "Application CEI Examen : notes, examens et mode examen verrouillé (équivalent de Safe Exam Browser)."
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "CEI Examen utilise la caméra pour la surveillance de l'examen.",
        "NSMicrophoneUsageDescription": "CEI Examen utilise le microphone pour la surveillance de l'examen.",
        "NSScreenCaptureDescription": "CEI Examen partage votre écran avec le surveillant pendant l'examen."
      }
    },
    "nsis": {
      "artifactName": "CEI-Examen-${version}-win-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CEI Examen",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "1036",
      "uninstallDisplayName": "CEI Examen"
    },
    "appImage": {
      "artifactName": "CEI-Examen-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "CEI-Examen-${version}-linux-amd64.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://cei.unchk.sn"
}
